class SharepointCli < Formula
  desc "Manage SharePoint sites, libraries, and files"
  homepage "https://github.com/rvben/sharepoint-cli"
  version "@VERSION@"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "@MAC_ARM_URL@"
      sha256 "@MAC_ARM_SHA256@"
    else
      url "@MAC_INTEL_URL@"
      sha256 "@MAC_INTEL_SHA256@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "@LINUX_ARM_URL@"
      sha256 "@LINUX_ARM_SHA256@"
    else
      url "@LINUX_INTEL_URL@"
      sha256 "@LINUX_INTEL_SHA256@"
    end
  end

  def install
    bin.install "sharepoint"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/sharepoint --version")
    assert_match "Usage:", shell_output("#{bin}/sharepoint --help")
  end
end
